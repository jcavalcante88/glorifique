# ==== Copie este arquivo para .env.local e preencha ====
# NUNCA envie o .env.local para o GitHub (ele já está no .gitignore)

# Endereço do site (em produção: https://glorifique.vercel.app ou seu domínio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Banco de dados (Neon) ---
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- Auth.js (login) ---
# Gere com:  npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub: https://github.com/settings/developers  (OAuth App)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Login por e-mail (link mágico) via Resend: https://resend.com
AUTH_RESEND_KEY=
EMAIL_FROM="Glorifique <nao-responda@seudominio.com>"

# E-mails que viram administradores (moderam testemunhos), separados por vírgula
ADMIN_EMAILS=jerrycamargodores@gmail.com

# --- Limite de requisições (Upstash Redis — instale pelo Marketplace da Vercel) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Armazenamento dos vídeos (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Doações (Pix) ---
NEXT_PUBLIC_PIX_CHAVE=+5511998817076
NEXT_PUBLIC_PIX_NOME=Jerry Cavalcante
NEXT_PUBLIC_PIX_CIDADE=SAO PAULO
